# Copy this file to `.env` and fill in the values.
# .env is ignored by Git so passwords never end up on GitHub.

# Port the web server listens on (Render sets this automatically).
PORT=3000

# "development" on your laptop, "production" on Render.
NODE_ENV=development

# MongoDB connection string from MongoDB Atlas.
# Leave it EMPTY during development: the app then starts a temporary
# in-memory MongoDB so nobody needs to install a database.
MONGODB_URI=

# Only if "npm run dev" fails with "querySrv ECONNREFUSED" on Windows and the
# automatic fallback doesn't help: force DNS servers for the Atlas lookup.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Secret used to sign login sessions. Use any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
