{
  "name": "home-appliance-marketplace",
  "version": "0.1.0",
  "description": "CS 476 project - a web marketplace for buying and selling new and used home appliances (Buyer and Seller roles, MVC, Observer and Simple Factory patterns).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "benchmark": "node scripts/benchmark-search.js",
    "seed": "node scripts/seed-database.js",
    "demo-photos": "node scripts/add-demo-photos.js"
  },
  "author": "Ilyan, Jaspreet, Anu, Jayant",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7"
  },
  "nodemonConfig": {
    "ignore": [
      "test/*",
      "docs/*",
      "scripts/*",
      "public/*"
    ],
    "ext": "js,json"
  }
}
